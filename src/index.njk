---
permalink: /
description: Kalkulačky a průvodci podle českých pravidel. Krok za krokem, v prohlížeči, bez registrace.
---
{%- from "komponenty/stitky.njk" import stitek -%}
{%- from "komponenty/karty.njk" import karta_nastroje, situace as situace_dlazdice, kategorie_dlazdice, zmena_2027 -%}
{%- from "komponenty/obsah.njk" import pomoc_dluhy -%}
{%- from "komponenty/ikona.njk" import ikona -%}
{%- set overeno = nastroje | posledniOvereni -%}
