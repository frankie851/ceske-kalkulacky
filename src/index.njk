    <div class="hero-grid">
      <div>
        <p class="eyebrow">Ahoj, tady {{ site.nazev }}</p>
        <h1 id="uvod-nadpis">S čím ti můžeme <span class="hi">pomoct?</span></h1>
        <p class="lead">{{ site.popis }}</p>
        <ul class="badges">
          {% if overeno %}{{ stitek({ typ: 'overeno', datum: overeno, li: true }) }}{% endif %}
          {{ stitek({ typ: 'plain', text: 'Nic neukládáme ani neodesíláme', li: true }) }}
        </ul>
      </div>
      <div class="hero-art">
          <svg viewBox="0 0 520 440" aria-hidden="true" focusable="false">
