              <text class="il-text" x="203" y="331" text-anchor="middle" font-size="22">2</text>
              <circle class="il-sage-d" cx="278" cy="305" r="21"/>
              <path class="st-cream" stroke-width="5" d="M268 305l7 7 13-14"/>
            </g>
            <circle class="il-paper" cx="104" cy="132" r="46"/>
            <circle class="st-terra" stroke-width="6" cx="104" cy="132" r="46"/>
            <path class="st-ink" stroke-width="4" d="M104 96v8M104 160v8M68 132h8M132 132h8"/>
            <path class="il-terra" d="M104 102l12 30h-24z"/>
            <path class="il-sage-d" d="M104 162l-12-30h24z"/>
            <circle class="il-ink" cx="104" cy="132" r="5"/>
            <g transform="rotate(-6 214 186)">
