            <path class="il-sage-d" d="M478 356c2-16-8-26-24-26-2 16 8 26 24 26z"/>
            <path class="il-terra" d="M458 366h40l-5 30a6 6 0 0 1-6 5h-18a6 6 0 0 1-6-5z"/>
            <path class="il-gold" d="M256 64q3 9 12 12q-9 3-12 12q-3-9-12-12q9-3 12-12z"/>
            <path class="il-gold" d="M486 108q2 7 9 9q-7 2-9 9q-2-7-9-9q7-2 9-9z"/>
