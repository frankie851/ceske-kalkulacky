          </svg>
      </div>
    </div>

    <h2 class="sr-only">Vyber svou situaci</h2>
    <p class="eyebrow" aria-hidden="true">Vyber, co se tě týká</p>
    <ul class="situ-grid">
      {%- for s in situace %}
      <li>{{ situace_dlazdice(s) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="zacni-nadpis">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Teď se hodí nejvíc</p>
      <h2 id="zacni-nadpis">Dvě věci, které stojí za to vyřešit do konce roku</h2>
    </div>
    <ul class="tool-grid">
      {%- for id in ['plan48', 'mam-eet'] %}
      {%- set n = nastroje | najdiNastroj(id) %}
      {%- if n %}<li>{{ karta_nastroje(n) }}</li>{% endif %}
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section-tight" aria-labelledby="kategorie-nadpis">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Nebo podle tématu</p>
      <h2 id="kategorie-nadpis">Vyber si téma</h2>
    </div>
    <ul class="cat-grid">
      {%- for k in kategorie %}
      <li>{{ kategorie_dlazdice({ nazev: k.nazev, popis: k.kratce, url: '/' + k.slug + '/', ikona: k.ilustrace }) }}</li>
      {%- endfor %}
      <li>{{ kategorie_dlazdice({ nazev: 'Co se mění v roce 2027', popis: 'Novinky a návrhy na jednom místě', url: '/co-se-meni-2027/', ikona: 'kategorie-2027' }) }}</li>
    </ul>
  </div>
</section>

<section class="section" id="zmeny-2027" aria-labelledby="zmeny-nadpis">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Ať tě nic nepřekvapí</p>
      <h2 id="zmeny-nadpis">Co se mění v roce 2027</h2>
      <p class="lead">Pět změn, o kterých je dobré vědět. U každé najdeš zdroj a jestli už platí, nebo je to zatím jen návrh.</p>
    </div>
    <ul class="changes">
      {%- for z in zmeny2027 %}
      {{ zmena_2027(z, nastroje) }}
      {%- endfor %}
    </ul>
  </div>
</section>

<div class="section-tight" id="dluhy">
  <div class="wrap">
    {% call pomoc_dluhy({ pomoc: pomoc, ilustrace: true, id: 'pomoc-uvod' }) %}
    <p class="small"><a class="debt-tool" href="{{ '/dluhy/' | url }}" data-pomoc>Co dělat, když vás tíží dluhy: klidný rozcestník bez reklam</a></p>
    <ul class="debt-rules">
      <li>{{ ikona('ikona-overeno') }}Žádné reklamy ani affiliate odkazy</li>
      <li>{{ ikona('ikona-overeno') }}Žádné nabídky půjček ani placení zprostředkovatelé</li>
      <li>{{ ikona('ikona-overeno') }}Žádné sbírání kontaktů</li>
    </ul>
    {% endcall %}
  </div>
</div>
